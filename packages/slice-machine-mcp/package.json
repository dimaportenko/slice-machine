{
  "name": "slice-machine-mcp",
  "version": "0.1.1",
  "private": true,
  "description": "Model Context Protocol (MCP) server for Slice Machine",
  "license": "Apache-2.0",
  "type": "module",
  "main": "build/index.js",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "slice-machine-mcp": "build/index.js"
  },
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "types": "tsc --noEmit",
    "lint": "echo 'no lint configured'",
    "inspect": "DANGEROUSLY_OMIT_AUTH=true npx @modelcontextprotocol/inspector tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@slicemachine/manager": "workspace:*",
    "io-ts": "2.2.20",
    "io-ts-types": "0.5.19",
    "r19": "0.1.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prismicio/types-internal": "3.11.2",
    "@types/node": "^20.0.0",
    "tsx": "4.6.2",
    "typescript": "4.9.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
